import React, { useState } from 'react';
import { EmailNotificationLog, UserProfile } from '../types';
import { 
  Mail, 
  X, 
  Search, 
  CheckCircle, 
  ExternalLink, 
  Clock, 
  ShieldCheck, 
  FileText, 
  Copy, 
  Check, 
  Send,
  Trash2,
  Inbox,
  Filter,
  Eye
} from 'lucide-react';

interface EmailInboxModalProps {
  isOpen: boolean;
  onClose: () => void;
  emails: EmailNotificationLog[];
  currentUser: UserProfile;
  onMarkAsRead?: (emailId: string) => void;
  onDeleteEmail?: (emailId: string) => void;
}

export const EmailInboxModal: React.FC<EmailInboxModalProps> = ({
  isOpen,
  onClose,
  emails = [],
  currentUser,
  onMarkAsRead,
  onDeleteEmail
}) => {
  const [selectedEmailId, setSelectedEmailId] = useState<string | null>((emails || []).length > 0 ? emails[0].id : null);
  const [searchQuery, setSearchQuery] = useState('');
  const [viewFormat, setViewFormat] = useState<'html' | 'plain'>('html');
  const [copied, setCopied] = useState(false);

  if (!isOpen) return null;

  const emailList = emails || [];

  const filteredEmails = emailList.filter(em => {
    const query = (searchQuery || '').toLowerCase();
    return (
      (em.subject || '').toLowerCase().includes(query) ||
      (em.recipientEmail || '').toLowerCase().includes(query) ||
      (em.bulletinTitle || '').toLowerCase().includes(query) ||
      (em.matchedKeywords || []).some(k => (k || '').toLowerCase().includes(query))
    );
  });

  const activeEmail = emailList.find(e => e.id === selectedEmailId) || (filteredEmails.length > 0 ? filteredEmails[0] : null);

  const handleCopyEmailText = () => {
    if (!activeEmail) return;
    navigator.clipboard.writeText(activeEmail.plainTextContent || '');
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-black/80 backdrop-blur-md animate-in fade-in duration-200">
      <div className="bg-[#080C14]/95 border border-white/15 w-full max-w-5xl h-[88vh] rounded-2xl shadow-2xl shadow-black/80 flex flex-col overflow-hidden text-slate-200 backdrop-blur-xl">
        
        {/* Top Header */}
        <div className="p-4 sm:p-5 bg-black/40 border-b border-white/10 flex items-center justify-between">
          <div className="flex items-center gap-3.5">
            <div className="w-11 h-11 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 border border-white/20 flex items-center justify-center text-white shadow-lg shadow-blue-500/20">
              <Mail className="w-5 h-5" />
            </div>
            <div>
              <div className="flex items-center gap-2.5">
                <h2 className="text-base font-bold text-white leading-tight">
                  Bandeja & Registro Histórico de Correos Despachados
                </h2>
                <span className="bg-blue-500/20 text-cyan-300 text-[10px] font-mono px-2.5 py-0.5 rounded-md border border-blue-500/30">
                  {emailList.length} alertas registradas
                </span>
              </div>
              <p className="text-xs text-slate-400 mt-0.5">
                Destinatario configurado: <strong className="text-slate-200">{currentUser?.email}</strong> ({currentUser?.mediaOutlet})
              </p>
            </div>
          </div>

          <button
            onClick={onClose}
            className="p-2 text-slate-400 hover:text-white rounded-xl hover:bg-white/10 transition-colors"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Master-Detail Layout */}
        <div className="flex-1 flex flex-col md:flex-row overflow-hidden">
          
          {/* Left Column: Email List */}
          <div className="w-full md:w-80 lg:w-96 bg-black/30 border-r border-white/10 flex flex-col">
            {/* Search filter bar */}
            <div className="p-3 border-b border-white/10">
              <div className="relative">
                <Search className="w-3.5 h-3.5 text-slate-400 absolute left-3 top-3" />
                <input
                  type="text"
                  value={searchQuery}
                  onChange={e => setSearchQuery(e.target.value)}
                  placeholder="Buscar por asunto, palabras clave, código..."
                  className="w-full pl-9 pr-3 py-2 bg-black/40 border border-white/10 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-hidden focus:border-cyan-400 transition-colors"
                />
              </div>
            </div>

            {/* List of emails */}
            <div className="flex-1 overflow-y-auto divide-y divide-white/5">
              {filteredEmails.length === 0 ? (
                <div className="p-8 text-center text-slate-500 text-xs space-y-2">
                  <Inbox className="w-8 h-8 mx-auto text-slate-600" />
                  <p>No hay correos que coincidan con la búsqueda.</p>
                </div>
              ) : (
                filteredEmails.map(em => {
                  const isSelected = em.id === (activeEmail?.id ?? '');
                  return (
                    <button
                      key={em.id}
                      onClick={() => {
                        setSelectedEmailId(em.id);
                        if (onMarkAsRead) onMarkAsRead(em.id);
                      }}
                      className={`w-full p-3.5 text-left transition-all flex flex-col gap-1.5 ${
                        isSelected
                          ? 'bg-blue-500/15 border-l-4 border-cyan-400 text-white shadow-inner'
                          : 'hover:bg-white/[0.04]'
                      }`}
                    >
                      <div className="flex items-center justify-between gap-1 text-[11px]">
                        <span className="font-mono text-cyan-300 truncate max-w-[140px]">
                          {em.bulletinCode}
                        </span>
                        <span className="text-slate-400 text-[10px]">
                          {new Date(em.sentAt).toLocaleTimeString('es-EC', { hour: '2-digit', minute: '2-digit' })}
                        </span>
                      </div>

                      <div className="text-xs font-semibold text-white line-clamp-2 leading-snug">
                        {em.subject}
                      </div>

                      <p className="text-[11px] text-slate-400 line-clamp-2 leading-relaxed">
                        {em.previewText}
                      </p>

                      <div className="flex items-center justify-between text-[10px] pt-1">
                        <span className="text-cyan-400 font-medium truncate max-w-[160px]">
                          {em.matchedProvinces.join(', ') || 'Nacional'}
                        </span>
                        {em.frequencyType === 'heartbeat_zero_updates' ? (
                          <span className="bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded border border-emerald-500/40 font-medium">
                            Sin Novedades
                          </span>
                        ) : (
                          <span className="bg-blue-500/20 text-cyan-300 px-2 py-0.5 rounded border border-blue-500/40 font-mono font-bold">
                            {em.relevanceScore}%
                          </span>
                        )}
                      </div>
                    </button>
                  );
                })
              )}
            </div>
          </div>

          {/* Right Column: Email Viewer */}
          <div className="flex-1 bg-black/20 flex flex-col overflow-hidden">
            {activeEmail ? (
              <>
                {/* Email Action Bar */}
                <div className="p-3 bg-black/40 border-b border-white/10 flex flex-wrap items-center justify-between gap-2">
                  <div className="flex items-center gap-2">
                    <div className="inline-flex rounded-xl border border-white/10 p-1 bg-black/40 text-xs">
                      <button
                        onClick={() => setViewFormat('html')}
                        className={`px-3 py-1 rounded-lg font-medium transition-colors ${
                          viewFormat === 'html' ? 'bg-blue-600 text-white font-bold' : 'text-slate-400 hover:text-white'
                        }`}
                      >
                        Formato Visual (HTML)
                      </button>
                      <button
                        onClick={() => setViewFormat('plain')}
                        className={`px-3 py-1 rounded-lg font-medium transition-colors ${
                          viewFormat === 'plain' ? 'bg-blue-600 text-white font-bold' : 'text-slate-400 hover:text-white'
                        }`}
                      >
                        Texto Plano (TXT)
                      </button>
                    </div>
                  </div>

                  <div className="flex items-center gap-2">
                    <button
                      onClick={handleCopyEmailText}
                      className="px-3 py-1.5 bg-white/5 hover:bg-white/10 text-slate-200 rounded-xl text-xs flex items-center gap-1.5 transition-all border border-white/10"
                      title="Copiar contenido del correo"
                    >
                      {copied ? <Check className="w-3.5 h-3.5 text-emerald-400" /> : <Copy className="w-3.5 h-3.5 text-slate-400" />}
                      <span>{copied ? 'Copiado' : 'Copiar'}</span>
                    </button>

                    <a
                      href={activeEmail.sourceUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="px-3 py-1.5 bg-blue-500/20 hover:bg-blue-500/30 text-cyan-300 border border-blue-500/30 rounded-xl text-xs flex items-center gap-1.5 transition-all font-semibold"
                    >
                      <ExternalLink className="w-3.5 h-3.5" />
                      <span>Ver Fuente CNE</span>
                    </a>
                  </div>
                </div>

                {/* Email Metadata Header */}
                <div className="p-4 bg-black/30 border-b border-white/10 text-xs space-y-2 backdrop-blur-xs">
                  <div className="flex items-start justify-between gap-3">
                    <h3 className="text-sm font-bold text-white leading-tight">
                      {activeEmail.subject}
                    </h3>
                    <span className="text-[11px] text-slate-400 shrink-0">
                      {new Date(activeEmail.sentAt).toLocaleString('es-EC', { 
                        dateStyle: 'medium', 
                        timeStyle: 'short' 
                      })}
                    </span>
                  </div>

                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-[11px] text-slate-400 pt-1">
                    <div>
                      <strong className="text-slate-300">De:</strong> Sistema CNE Alerta IA &lt;alertas@cne-monitor.ec&gt;
                    </div>
                    <div>
                      <strong className="text-slate-300">Para:</strong> {activeEmail.recipientMediaOutlet} &lt;{activeEmail.recipientEmail}&gt;
                    </div>
                    <div>
                      <strong className="text-slate-300">Firma Criptográfica SHA-256:</strong> <code className="text-slate-300 font-mono text-[10px]">{activeEmail.authenticityHash.substring(0, 24)}...</code>
                    </div>
                    <div>
                      <strong className="text-slate-300">Frecuencia:</strong> {activeEmail.frequencyType === 'immediate' ? 'Alerta Inmediata' : activeEmail.frequencyType === 'daily_summary' ? 'Resumen Diario' : activeEmail.frequencyType === 'heartbeat_zero_updates' ? 'Vigilancia Activa' : 'Resumen Semanal'}
                    </div>
                  </div>
                </div>

                {/* Email Body Viewer */}
                <div className="flex-1 overflow-y-auto p-4 sm:p-6 bg-black/20">
                  {viewFormat === 'html' ? (
                    <div 
                      className="rounded-xl shadow-2xl overflow-hidden max-w-2xl mx-auto border border-white/10"
                      dangerouslySetInnerHTML={{ __html: activeEmail.htmlContent }}
                    />
                  ) : (
                    <pre className="p-4 bg-black/40 border border-white/10 rounded-xl text-xs font-mono text-slate-300 whitespace-pre-wrap leading-relaxed max-w-2xl mx-auto">
                      {activeEmail.plainTextContent}
                    </pre>
                  )}
                </div>
              </>
            ) : (
              <div className="flex-1 flex flex-col items-center justify-center p-8 text-center text-slate-500 text-xs">
                <Mail className="w-10 h-10 text-slate-700 mb-2" />
                <p>Seleccione un correo de la lista izquierda para visualizar su contenido oficial.</p>
              </div>
            )}
          </div>

        </div>

      </div>
    </div>
  );
};
